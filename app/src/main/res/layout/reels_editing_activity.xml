<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/dark_surface">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text"
            android:contentDescription="@string/back_button" />

        <!-- Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reels_editing"
            android:textSize="18sp"
            android:textColor="@color/light_text"
            android:textStyle="bold"
            android:paddingStart="16dp" />

    </LinearLayout>

    <!-- Center Preview Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/video_preview_background">

        <!-- Video Preview Placeholder -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dark_surface_variant">

            <!-- Play Icon in Center -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_centerInParent="true"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/light_text_secondary"
                android:alpha="0.5"
                android:contentDescription="@string/video_preview" />

            <!-- Video Duration Indicator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_duration"
                android:textSize="14sp"
                android:textColor="@color/light_text"
                android:background="@drawable/duration_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="16dp" />

        </RelativeLayout>

    </FrameLayout>

    <!-- Bottom Tools Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="vertical"
        android:background="@color/dark_surface"
        android:paddingVertical="12dp"
        android:paddingHorizontal="8dp">

        <!-- Buttons Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="false">

            <!-- Music Button -->
            <LinearLayout
                android:id="@+id/music_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@color/light_text"
                    android:contentDescription="@string/music" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/music"
                    android:textSize="12sp"
                    android:textColor="@color/light_text"
                    android:layout_marginTop="4dp"
                    android:textAlignment="center" />

            </LinearLayout>

            <!-- Text Button -->
            <LinearLayout
                android:id="@+id/text_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:tint="@color/light_text"
                    android:contentDescription="@string/text_label" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_label"
                    android:textSize="12sp"
                    android:textColor="@color/light_text"
                    android:layout_marginTop="4dp"
                    android:textAlignment="center" />

            </LinearLayout>

            <!-- Effects Button -->
            <LinearLayout
                android:id="@+id/effects_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:tint="@color/light_text"
                    android:contentDescription="@string/effects" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/effects"
                    android:textSize="12sp"
                    android:textColor="@color/light_text"
                    android:layout_marginTop="4dp"
                    android:textAlignment="center" />

            </LinearLayout>

            <!-- Export Button -->
            <LinearLayout
                android:id="@+id/export_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/button_background_accent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_share"
                    android:tint="@color/accent_color"
                    android:contentDescription="@string/export" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export"
                    android:textSize="12sp"
                    android:textColor="@color/accent_color"
                    android:layout_marginTop="4dp"
                    android:textAlignment="center"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
